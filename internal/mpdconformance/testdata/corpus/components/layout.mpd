@column
@docs-preview eyebrow="Documentation" title="Create a project" description="One command creates the site."
$ mpress new docs
@end
@end
@end
@end

@container display="grid" columns=2 gap="1rem"
@callout title="Static" icon="zap"
The complete layout exists in generated HTML.
@end
@callout title="Responsive" icon="monitor"
Dense layouts collapse on small screens.
@end
@end

@cards cols=2
@card href="/start/" title="Start a project"
Install one binary.
@end
@card href="/configure/" title="Configure the site"
Use one YAML file.
@end
@end

@preview-tabs
@tab label="Markdown"
Write plain text.
@end
@tab label="Output"
Publish static HTML.
@end
@end

@file-tabs
@tab label="index.md"
```markdown
# Hello world
```
@end
